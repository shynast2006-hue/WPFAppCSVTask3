<mah:MetroWindow x:Class="WPFApp.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:models="clr-namespace:WPFApp.Models"
                 Title="{DynamicResource WindowTitle}"
                 Height="720" Width="1120"
                 MinHeight="620" MinWidth="960"
                 WindowStartupLocation="CenterScreen"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <Grid>
        <Grid Margin="16" IsEnabled="{Binding IsNotBusy}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10"
                        HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                           Text="{DynamicResource LanguageLabel}" />
                <ComboBox Width="150"
                          ItemsSource="{Binding Languages}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedLanguage}" />
            </StackPanel>

            <GroupBox Grid.Row="1" Padding="10" Header="{DynamicResource ImportHeader}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="{DynamicResource CsvFileLabel}" />
                    <TextBox Grid.Row="1" Height="32" IsReadOnly="True"
                             Text="{Binding CsvPath}" VerticalContentAlignment="Center" />
                    <Button Grid.Row="1" Grid.Column="1" MinWidth="110" Margin="10,0,0,0"
                            Command="{Binding ChooseCsvCommand}" Content="{DynamicResource ChooseButton}" />
                    <Button Grid.Row="1" Grid.Column="2" MinWidth="110" Margin="10,0,0,0"
                            Command="{Binding ImportCommand}" Content="{DynamicResource OpenButton}" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Margin="0,12" Padding="10" Header="{DynamicResource SearchHeader}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="{DynamicResource DateFromLabel}" />
                    <Label Grid.Column="1" Content="{DynamicResource DateToLabel}" />
                    <Label Grid.Column="2" Content="{DynamicResource FirstNameLabel}" />
                    <Label Grid.Column="3" Content="{DynamicResource LastNameLabel}" />
                    <Label Grid.Column="4" Content="{DynamicResource SurNameLabel}" />
                    <Label Grid.Column="5" Content="{DynamicResource CityLabel}" />
                    <Label Grid.Column="6" Content="{DynamicResource CountryLabel}" />

                    <!-- В календаре дату «по» нельзя выбрать раньше даты «с». -->
                    <DatePicker Grid.Row="1" Margin="0,2,8,0"
                                SelectedDate="{Binding FromDate}"
                                DisplayDateEnd="{Binding ToDate}"
                                 DateValidationError="DatePicker_DateValidationError"
                                mah:TextBoxHelper.Watermark="{DynamicResource DatePlaceholder}" />
                    <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,2,8,0"
                                SelectedDate="{Binding ToDate}"
                                DisplayDateStart="{Binding FromDate}"
                                 DateValidationError="DatePicker_DateValidationError"
                                mah:TextBoxHelper.Watermark="{DynamicResource DatePlaceholder}" />
                    <TextBox Grid.Row="1" Grid.Column="2" Height="30" Margin="0,2,8,0"
                             MaxLength="{x:Static models:PersonRecord.MaxTextLength}" VerticalContentAlignment="Center"
                             Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="1" Grid.Column="3" Height="30" Margin="0,2,8,0"
                             MaxLength="{x:Static models:PersonRecord.MaxTextLength}" VerticalContentAlignment="Center"
                             Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="1" Grid.Column="4" Height="30" Margin="0,2,8,0"
                             MaxLength="{x:Static models:PersonRecord.MaxTextLength}" VerticalContentAlignment="Center"
                             Text="{Binding SurName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="1" Grid.Column="5" Height="30" Margin="0,2,8,0"
                             MaxLength="{x:Static models:PersonRecord.MaxTextLength}" VerticalContentAlignment="Center"
                             Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="1" Grid.Column="6" Height="30" Margin="0,2,0,0"
                             MaxLength="{x:Static models:PersonRecord.MaxTextLength}" VerticalContentAlignment="Center"
                             Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="1" Grid.Column="7" MinWidth="90" Margin="10,2,0,0"
                            IsDefault="True"
                            Command="{Binding SearchCommand}" Content="{DynamicResource SearchButton}" />
                </Grid>
            </GroupBox>

            <DataGrid Grid.Row="3" ItemsSource="{Binding Records}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="110" Binding="{Binding Date, StringFormat=dd.MM.yyyy}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource ColumnDate}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="*" Binding="{Binding FirstName}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource ColumnFirstName}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="*" Binding="{Binding LastName}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource ColumnLastName}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="*" Binding="{Binding SurName}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource ColumnSurName}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="*" Binding="{Binding City}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource ColumnCity}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="*" Binding="{Binding Country}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource ColumnCountry}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="4" Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button MinWidth="85" Command="{Binding PreviousPageCommand}"
                            Content="{DynamicResource PreviousButton}" />
                    <TextBlock MinWidth="130" Margin="10,0" VerticalAlignment="Center"
                               Text="{Binding PageText}" TextAlignment="Center" />
                    <Button MinWidth="85" Command="{Binding NextPageCommand}"
                            Content="{DynamicResource NextButton}" />
                    <Button MinWidth="135" Margin="12,0,0,0" Command="{Binding ExportExcelCommand}"
                            Content="{DynamicResource ExportExcelButton}" ToolTip="{DynamicResource ExportHint}" />
                    <Button MinWidth="135" Margin="10,0,0,0" Command="{Binding ExportXmlCommand}"
                            Content="{DynamicResource ExportXmlButton}" ToolTip="{DynamicResource ExportHint}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" />
            </DockPanel>
        </Grid>

        
        <mah:ProgressRing Width="60" Height="60" IsHitTestVisible="False"
                          IsActive="{Binding IsBusy}" />
    </Grid>
</mah:MetroWindow>
