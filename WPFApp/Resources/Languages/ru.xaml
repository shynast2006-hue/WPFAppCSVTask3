<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <system:String x:Key="WindowTitle">Импорт CSV</system:String>
    <system:String x:Key="LanguageLabel">Язык:</system:String>
    <system:String x:Key="ImportHeader">Импорт данных</system:String>
    <system:String x:Key="CsvFileLabel">CSV-файл</system:String>
    <system:String x:Key="ChooseButton">Выбрать...</system:String>
    <system:String x:Key="OpenButton">Открыть</system:String>
    <system:String x:Key="SearchHeader">Поиск</system:String>
    <system:String x:Key="DateFromLabel">Дата с</system:String>
    <system:String x:Key="DateToLabel">Дата по</system:String>
    <system:String x:Key="DatePlaceholder">Выбор даты</system:String>
    <system:String x:Key="FirstNameLabel">Имя</system:String>
    <system:String x:Key="LastNameLabel">Фамилия</system:String>
    <system:String x:Key="SurNameLabel">Отчество</system:String>
    <system:String x:Key="CityLabel">Город</system:String>
    <system:String x:Key="CountryLabel">Страна</system:String>
    <system:String x:Key="SearchButton">Найти</system:String>
    <system:String x:Key="ColumnDate">Дата</system:String>
    <system:String x:Key="ColumnFirstName">Имя</system:String>
    <system:String x:Key="ColumnLastName">Фамилия</system:String>
    <system:String x:Key="ColumnSurName">Отчество</system:String>
    <system:String x:Key="ColumnCity">Город</system:String>
    <system:String x:Key="ColumnCountry">Страна</system:String>
    <system:String x:Key="PreviousButton">Назад</system:String>
    <system:String x:Key="NextButton">Вперёд</system:String>
    <system:String x:Key="ExportExcelButton">Экспорт в Excel</system:String>
    <system:String x:Key="ExportXmlButton">Экспорт в XML</system:String>
    <system:String x:Key="ExportHint">Сохраняются записи, найденные последним поиском.</system:String>
    <system:String x:Key="ExcelSheetName">Записи</system:String>

    <system:String x:Key="StatusChooseCsv">Выберите CSV-файл.</system:String>
    <system:String x:Key="StatusLanguageChanged">Язык изменён.</system:String>
    <system:String x:Key="CsvDialogFilter">CSV-файлы (*.csv)|*.csv</system:String>
    <system:String x:Key="CsvDialogTitle">Выберите CSV-файл</system:String>
    <system:String x:Key="StatusCsvSelected">CSV-файл выбран.</system:String>
    <system:String x:Key="ImportTitle">Импорт</system:String>
    <system:String x:Key="ConfirmReplace">Все записи в базе будут заменены записями из выбранного файла. Продолжить?</system:String>
    <system:String x:Key="StatusImporting">Импорт данных...</system:String>
    <system:String x:Key="ErrorImport">Не удалось импортировать CSV-файл.</system:String>
    <system:String x:Key="ImportSuccess">Данные заменены.&#10;&#10;Добавлено записей: {0}&#10;Пропущено строк: {1}</system:String>
    <system:String x:Key="SearchTitle">Поиск</system:String>
    <system:String x:Key="WarningDateRange">Дата «с» не может быть позже даты «по».</system:String>
    <system:String x:Key="WarningInvalidDate">Введите корректную дату в допустимом диапазоне.</system:String>
    <system:String x:Key="StatusSearching">Поиск записей...</system:String>
    <system:String x:Key="ErrorSearch">Не удалось выполнить поиск.</system:String>
    <system:String x:Key="StatusNoRecords">Записи не найдены.</system:String>
    <system:String x:Key="StatusFound">Найдено записей: {0}.</system:String>
    <system:String x:Key="NoPages">Страниц нет</system:String>
    <system:String x:Key="PageFormat">Страница {0} из {1}</system:String>
    <system:String x:Key="ExcelDialogFilter">Excel-файл (*.xlsx)|*.xlsx</system:String>
    <system:String x:Key="ExportExcelTitle">Экспорт в Excel</system:String>
    <system:String x:Key="StatusExportingExcel">Создание Excel-файла...</system:String>
    <system:String x:Key="StatusExcelCreated">Excel-файл успешно создан.</system:String>
    <system:String x:Key="ErrorExcel">Не удалось создать Excel-файл.</system:String>
    <system:String x:Key="XmlDialogFilter">XML-файл (*.xml)|*.xml</system:String>
    <system:String x:Key="ExportXmlTitle">Экспорт в XML</system:String>
    <system:String x:Key="StatusExportingXml">Создание XML-файла...</system:String>
    <system:String x:Key="StatusXmlCreated">XML-файл успешно создан.</system:String>
    <system:String x:Key="ErrorXml">Не удалось создать XML-файл.</system:String>

    <system:String x:Key="ErrorTitle">Ошибка</system:String>
    <system:String x:Key="ErrorStartup">Не удалось запустить приложение. Проверьте настройки подключения к базе данных и наличие MS SQL Server LocalDB.</system:String>
    <system:String x:Key="ErrorFileNotFound">Выбранный файл не найден.</system:String>
    <system:String x:Key="ErrorInvalidCsv">Файл не подходит. Нужен CSV-файл в кодировке UTF-8, поля разделены «;», например: 01.01.2015;Иван;Иванов;Иванович;Гомель;Беларусь. Данные в базе не изменены.</system:String>
    <system:String x:Key="ErrorAccessDenied">Нет доступа к выбранному файлу или папке.</system:String>
    <system:String x:Key="ErrorFileIo">Не удалось прочитать или сохранить файл. Возможно, он открыт в другой программе.</system:String>
    <system:String x:Key="ErrorDatabase">Нет связи с базой данных. Проверьте, что MS SQL Server LocalDB установлен и запущен.</system:String>
    <system:String x:Key="ErrorDatabaseSave">Не удалось сохранить записи в базе данных. Проверьте данные и работу SQL Server.</system:String>
    <system:String x:Key="ErrorGeneric">Проверьте выбранные данные и повторите попытку.</system:String>
</ResourceDictionary>
