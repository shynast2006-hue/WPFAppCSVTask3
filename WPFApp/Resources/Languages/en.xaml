<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <system:String x:Key="WindowTitle">CSV Import</system:String>
    <system:String x:Key="LanguageLabel">Language:</system:String>
    <system:String x:Key="ImportHeader">Data import</system:String>
    <system:String x:Key="CsvFileLabel">CSV file</system:String>
    <system:String x:Key="ChooseButton">Choose...</system:String>
    <system:String x:Key="OpenButton">Open</system:String>
    <system:String x:Key="SearchHeader">Search</system:String>
    <system:String x:Key="DateFromLabel">Date from</system:String>
    <system:String x:Key="DateToLabel">Date to</system:String>
    <system:String x:Key="DatePlaceholder">Select a date</system:String>
    <system:String x:Key="FirstNameLabel">First name</system:String>
    <system:String x:Key="LastNameLabel">Last name</system:String>
    <system:String x:Key="SurNameLabel">Patronymic</system:String>
    <system:String x:Key="CityLabel">City</system:String>
    <system:String x:Key="CountryLabel">Country</system:String>
    <system:String x:Key="SearchButton">Search</system:String>
    <system:String x:Key="ColumnDate">Date</system:String>
    <system:String x:Key="ColumnFirstName">First name</system:String>
    <system:String x:Key="ColumnLastName">Last name</system:String>
    <system:String x:Key="ColumnSurName">Patronymic</system:String>
    <system:String x:Key="ColumnCity">City</system:String>
    <system:String x:Key="ColumnCountry">Country</system:String>
    <system:String x:Key="PreviousButton">Previous</system:String>
    <system:String x:Key="NextButton">Next</system:String>
    <system:String x:Key="ExportExcelButton">Export to Excel</system:String>
    <system:String x:Key="ExportXmlButton">Export to XML</system:String>
    <system:String x:Key="ExportHint">Records found by the last search are saved.</system:String>
    <system:String x:Key="ExcelSheetName">Records</system:String>

    <system:String x:Key="StatusChooseCsv">Choose a CSV file.</system:String>
    <system:String x:Key="StatusLanguageChanged">Language changed.</system:String>
    <system:String x:Key="CsvDialogFilter">CSV files (*.csv)|*.csv</system:String>
    <system:String x:Key="CsvDialogTitle">Choose a CSV file</system:String>
    <system:String x:Key="StatusCsvSelected">CSV file selected.</system:String>
    <system:String x:Key="ImportTitle">Import</system:String>
    <system:String x:Key="ConfirmReplace">All records in the database will be replaced with records from the selected file. Continue?</system:String>
    <system:String x:Key="StatusImporting">Importing data...</system:String>
    <system:String x:Key="ErrorImport">Failed to import the CSV file.</system:String>
    <system:String x:Key="ImportSuccess">Data replaced.&#10;&#10;Records added: {0}&#10;Rows skipped: {1}</system:String>
    <system:String x:Key="SearchTitle">Search</system:String>
    <system:String x:Key="WarningDateRange">The “from” date cannot be later than the “to” date.</system:String>
    <system:String x:Key="WarningInvalidDate">Enter a valid date within the allowed range.</system:String>
    <system:String x:Key="StatusSearching">Searching records...</system:String>
    <system:String x:Key="ErrorSearch">Search failed.</system:String>
    <system:String x:Key="StatusNoRecords">No records found.</system:String>
    <system:String x:Key="StatusFound">Records found: {0}.</system:String>
    <system:String x:Key="NoPages">No pages</system:String>
    <system:String x:Key="PageFormat">Page {0} of {1}</system:String>
    <system:String x:Key="ExcelDialogFilter">Excel file (*.xlsx)|*.xlsx</system:String>
    <system:String x:Key="ExportExcelTitle">Export to Excel</system:String>
    <system:String x:Key="StatusExportingExcel">Creating Excel file...</system:String>
    <system:String x:Key="StatusExcelCreated">Excel file created successfully.</system:String>
    <system:String x:Key="ErrorExcel">Failed to create the Excel file.</system:String>
    <system:String x:Key="XmlDialogFilter">XML file (*.xml)|*.xml</system:String>
    <system:String x:Key="ExportXmlTitle">Export to XML</system:String>
    <system:String x:Key="StatusExportingXml">Creating XML file...</system:String>
    <system:String x:Key="StatusXmlCreated">XML file created successfully.</system:String>
    <system:String x:Key="ErrorXml">Failed to create the XML file.</system:String>

    <system:String x:Key="ErrorTitle">Error</system:String>
    <system:String x:Key="ErrorStartup">The application could not be started. Check the database connection settings and make sure MS SQL Server LocalDB is installed.</system:String>
    <system:String x:Key="ErrorFileNotFound">The selected file was not found.</system:String>
    <system:String x:Key="ErrorInvalidCsv">The file is not suitable. A UTF-8 CSV file with fields separated by “;” is required, for example: 01.01.2015;Ivan;Ivanov;Ivanovich;Gomel;Belarus. The data in the database has not been changed.</system:String>
    <system:String x:Key="ErrorAccessDenied">Access to the selected file or folder is denied.</system:String>
    <system:String x:Key="ErrorFileIo">The file could not be read or saved. It may be open in another program.</system:String>
    <system:String x:Key="ErrorDatabase">Cannot connect to the database. Make sure MS SQL Server LocalDB is installed and running.</system:String>
    <system:String x:Key="ErrorDatabaseSave">Could not save records to the database. Check the data and SQL Server.</system:String>
    <system:String x:Key="ErrorGeneric">Check the selected data and try again.</system:String>
</ResourceDictionary>
