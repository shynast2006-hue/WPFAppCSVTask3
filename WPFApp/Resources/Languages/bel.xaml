<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <system:String x:Key="WindowTitle">Імпарт CSV</system:String>
    <system:String x:Key="LanguageLabel">Мова:</system:String>
    <system:String x:Key="ImportHeader">Імпарт даных</system:String>
    <system:String x:Key="CsvFileLabel">CSV-файл</system:String>
    <system:String x:Key="ChooseButton">Выбраць...</system:String>
    <system:String x:Key="OpenButton">Адкрыць</system:String>
    <system:String x:Key="SearchHeader">Пошук</system:String>
    <system:String x:Key="DateFromLabel">Дата ад</system:String>
    <system:String x:Key="DateToLabel">Дата да</system:String>
    <system:String x:Key="DatePlaceholder">Выбар даты</system:String>
    <system:String x:Key="FirstNameLabel">Імя</system:String>
    <system:String x:Key="LastNameLabel">Прозвішча</system:String>
    <system:String x:Key="SurNameLabel">Імя па бацьку</system:String>
    <system:String x:Key="CityLabel">Горад</system:String>
    <system:String x:Key="CountryLabel">Краіна</system:String>
    <system:String x:Key="SearchButton">Знайсці</system:String>
    <system:String x:Key="ColumnDate">Дата</system:String>
    <system:String x:Key="ColumnFirstName">Імя</system:String>
    <system:String x:Key="ColumnLastName">Прозвішча</system:String>
    <system:String x:Key="ColumnSurName">Імя па бацьку</system:String>
    <system:String x:Key="ColumnCity">Горад</system:String>
    <system:String x:Key="ColumnCountry">Краіна</system:String>
    <system:String x:Key="PreviousButton">Назад</system:String>
    <system:String x:Key="NextButton">Наперад</system:String>
    <system:String x:Key="ExportExcelButton">Экспарт у Excel</system:String>
    <system:String x:Key="ExportXmlButton">Экспарт у XML</system:String>
    <system:String x:Key="ExportHint">Захоўваюцца запісы, знойдзеныя апошнім пошукам.</system:String>
    <system:String x:Key="ExcelSheetName">Запісы</system:String>

    <system:String x:Key="StatusChooseCsv">Выберыце CSV-файл.</system:String>
    <system:String x:Key="StatusLanguageChanged">Мова зменена.</system:String>
    <system:String x:Key="CsvDialogFilter">CSV-файлы (*.csv)|*.csv</system:String>
    <system:String x:Key="CsvDialogTitle">Выберыце CSV-файл</system:String>
    <system:String x:Key="StatusCsvSelected">CSV-файл выбраны.</system:String>
    <system:String x:Key="ImportTitle">Імпарт</system:String>
    <system:String x:Key="ConfirmReplace">Усе запісы ў базе будуць заменены запісамі з выбранага файла. Працягнуць?</system:String>
    <system:String x:Key="StatusImporting">Імпарт даных...</system:String>
    <system:String x:Key="ErrorImport">Не ўдалося імпартаваць CSV-файл.</system:String>
    <system:String x:Key="ImportSuccess">Даныя заменены.&#10;&#10;Дададзена запісаў: {0}&#10;Прапушчана радкоў: {1}</system:String>
    <system:String x:Key="SearchTitle">Пошук</system:String>
    <system:String x:Key="WarningDateRange">Дата «ад» не можа быць пазней за дату «да».</system:String>
    <system:String x:Key="WarningInvalidDate">Увядзіце правільную дату ў дапушчальным дыяпазоне.</system:String>
    <system:String x:Key="StatusSearching">Пошук запісаў...</system:String>
    <system:String x:Key="ErrorSearch">Не ўдалося выканаць пошук.</system:String>
    <system:String x:Key="StatusNoRecords">Запісы не знойдзены.</system:String>
    <system:String x:Key="StatusFound">Знойдзена запісаў: {0}.</system:String>
    <system:String x:Key="NoPages">Старонак няма</system:String>
    <system:String x:Key="PageFormat">Старонка {0} з {1}</system:String>
    <system:String x:Key="ExcelDialogFilter">Excel-файл (*.xlsx)|*.xlsx</system:String>
    <system:String x:Key="ExportExcelTitle">Экспарт у Excel</system:String>
    <system:String x:Key="StatusExportingExcel">Стварэнне Excel-файла...</system:String>
    <system:String x:Key="StatusExcelCreated">Excel-файл паспяхова створаны.</system:String>
    <system:String x:Key="ErrorExcel">Не ўдалося стварыць Excel-файл.</system:String>
    <system:String x:Key="XmlDialogFilter">XML-файл (*.xml)|*.xml</system:String>
    <system:String x:Key="ExportXmlTitle">Экспарт у XML</system:String>
    <system:String x:Key="StatusExportingXml">Стварэнне XML-файла...</system:String>
    <system:String x:Key="StatusXmlCreated">XML-файл паспяхова створаны.</system:String>
    <system:String x:Key="ErrorXml">Не ўдалося стварыць XML-файл.</system:String>

    <system:String x:Key="ErrorTitle">Памылка</system:String>
    <system:String x:Key="ErrorStartup">Не ўдалося запусціць праграму. Праверце налады падключэння да базы даных і наяўнасць MS SQL Server LocalDB.</system:String>
    <system:String x:Key="ErrorFileNotFound">Выбраны файл не знойдзены.</system:String>
    <system:String x:Key="ErrorInvalidCsv">Файл не падыходзіць. Патрэбны CSV-файл у кадаванні UTF-8, палі раздзелены «;», напрыклад: 01.01.2015;Іван;Іваноў;Іванавіч;Гомель;Беларусь. Даныя ў базе не зменены.</system:String>
    <system:String x:Key="ErrorAccessDenied">Няма доступу да выбранага файла або папкі.</system:String>
    <system:String x:Key="ErrorFileIo">Не ўдалося прачытаць або захаваць файл. Магчыма, ён адкрыты ў іншай праграме.</system:String>
    <system:String x:Key="ErrorDatabase">Няма сувязі з базай даных. Праверце, што MS SQL Server LocalDB усталяваны і запушчаны.</system:String>
    <system:String x:Key="ErrorDatabaseSave">Не ўдалося захаваць запісы ў базе даных. Праверце даныя і працу SQL Server.</system:String>
    <system:String x:Key="ErrorGeneric">Праверце выбраныя даныя і паўтарыце спробу.</system:String>
</ResourceDictionary>
